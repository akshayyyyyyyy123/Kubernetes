2. Pod reads the Secret

secret-pod.yaml

apiVersion: v1
kind: Pod
metadata:
  name: app-pod-2
spec:
  containers:
    - name: app-container
      image: busybox:1.36
      command:
        - sh
        - -c
        - |
          echo "DB_USERNAME = $DB_USERNAME"
          echo "DB_NAME = $DB_NAME"
          sleep 3600
      
      env:
        - name: DB_USERNAME
          valueFrom:
            secretKeyRef:
              name: db-secret
              key: username

        - name: DB_NAME
          valueFrom:
            secretKeyRef:
              name: db-secret
              key: dbname

# kubectl apply -f secret-pod.yaml
pod/app-pod-2 created

# kubectl logs app-pod-2
