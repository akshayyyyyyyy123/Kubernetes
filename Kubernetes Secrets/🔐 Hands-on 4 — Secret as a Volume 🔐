🔐 Hands-on 4 — Secret as a Volume 🔐

- Now we'll make the Secret available as files inside the container.

--------------------------------------------------------------------------------------------------------------------------

STEP 01 — Create Secrets

apiVersion: v1
kind: Secret

metadata:
  name: db-secret

# default secret type
type: Opaque

data:
  username: cGF5bWVudF91c2Vy
  password: cGF5bWVudEAxMjM=
  dbname: cGF5bWVudF9kYg==

--------------------------------------------------------------------------------------------------------------------------

STEP 02 — Create the Pod

apiVersion: v1
kind: Pod
metadata:
  name: app-secret-pod-05
spec:
  containers:
    - name: app-container-02
      image: busybox:1.36
      command:
        - sh
        - -c
        - |
          echo "Files inside /etc/secrets :"
          ls -l /tmp/secrets

          echo "Username : $(cat /tmp/secrets/username)"
          echo "DB Name : $(cat /tmp/secrets/dbname)"

          sleep 120

      volumeMounts:
        - name: db-secret-volume
          mountPath: /tmp/secrets

  volumes:
    - name: db-secret-volume
      secret:
        secretName: db-secret

--------------------------------------------------------------------------------------------------------------------------

