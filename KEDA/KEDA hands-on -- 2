5. Create scaled object

redis-scaledobject.yaml

apiVersion: keda.sh/v1alpha1
kind: ScaledObject

metadata:
  name: redis-worker-scaler
  namespace: keda-redis-ns

spec:
  scaleTargetRef:
    name: worker-deployment

  pollingInterval: 10
  cooldownPeriod: 30

  minReplicaCount: 0
  maxReplicaCount: 5

  triggers:
    - type: redis
      metadata:
        address: redis-svc.keda-redis-ns.svc.cluster.local:6379
        listName: jobs
        listLength: "5"

# <service-name>.<namespace>.svc.cluster.local:<port>
# redis-svc.keda-redis-ns.svc.cluster.local:6379


