STEP 03: Deploy a sample application

Deployment.yaml

apiVersion: apps/v1
kind: Deployment
metadata:
  name: demo-app
  namespace: keda-lab
spec:
  replicas: 1
  selector:
    matchLabels:
      app: demo-app
  template:
    metadata:
      labels:
        app: demo-app
    spec:
      containers:
        - name: nginx
          image: nginx:1.27
          ports:
            - containerPort: 80


# kubectl apply -f deployment.yaml
deployment.apps/demo-app created

# kubectl get deployments -n keda-lab                                                                                                                 
